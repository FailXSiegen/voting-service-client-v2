{
  "name": "voting-service-client",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/seo-postbuild.mjs",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom --dir src/",
    "test:e2e": "start-server-and-test preview :4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' :4173 'cypress open --e2e'",
    "test:load": "npx playwright test tests/load-test/load-test.spec.js",
    "test:load:simple": "npx playwright test tests/load-test/load-test.spec.js --project=chromium --grep \"Simple load test\"",
    "lint": "eslint --fix src",
    "lint:check": "eslint src",
    "format": "prettier src --write",
    "format:check": "prettier src --check",
    "lint:debug": "bash bin/find-forbidden-words.sh",
    "qa": "npm run lint:check && npm run format:check && npm run lint:debug",
    "qa:cpd": "jscpd src",
    "qa:unused": "knip",
    "qa:all": "npm run qa && npm run qa:cpd && npm run qa:unused",
    "before:commit": "npm run lint:check && npm run lint:debug && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@apollo/client": "^3.8.8",
    "@ckeditor/ckeditor5-vue": "^9.0.0",
    "@popperjs/core": "^2.11.8",
    "@unhead/vue": "^3.4.3",
    "@vue/apollo-composable": "^4.0.0",
    "@vue/apollo-option": "^4.0.0",
    "@vue/apollo-util": "^4.0.0-beta.2",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@zoom/meetingsdk": "^6.0.0",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.2",
    "ckeditor5": "^49.0.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.4.1",
    "jquery": "^4.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.3.9",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0",
    "vue3-easy-data-table": "^1.5.47",
    "vue3-toastify": "^0.2.9",
    "vuejs-confirm-dialog": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@rollup/plugin-inject": "^5.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.3",
    "csv-parser": "^3.2.0",
    "cypress": "^16.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jscpd": "4.0.8",
    "jsdom": "^30.1.3",
    "knip": "^6.3.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.0",
    "sass": "^1.69.5",
    "start-server-and-test": "^3.0.13",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "axios": ">=1.15.0",
    "qs": "^6.16.0",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "js-beautify": {
      "glob": "^14.0.2"
    }
  },
  "engines": {
    "npm": ">=9.0.0",
    "node": ">=22.0.0"
  }
}
